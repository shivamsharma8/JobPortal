{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "AuthDb": "Host=postgres;Port=5432;Database=auth_db;Username=hireconnect;Password=hireconnect_secret;",
    "Redis": "redis:6379"
  },
  "JwtSettings": {
    "SecretKey": "HireConnect_SuperSecretKey_Must_Be_At_Least_32_Chars!",
    "Issuer": "hireconnect-auth-service",
    "Audience": "hireconnect-clients",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "GitHub": {
    "ClientId": "YOUR_GITHUB_CLIENT_ID",
    "ClientSecret": "YOUR_GITHUB_CLIENT_SECRET",
    "CallbackUrl": "http://localhost:5001/api/v1/auth/github/callback"
  },
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://gateway:5000"
  ],
  "AllowedHosts": "*",
  "Urls": "http://+:8080"
}
