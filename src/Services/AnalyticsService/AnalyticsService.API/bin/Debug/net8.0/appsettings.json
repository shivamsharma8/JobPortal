{
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "System": "Warning" } }
  },
  "ConnectionStrings": {
    "AnalyticsDb": "Host=postgres;Port=5432;Database=analytics_db;Username=hireconnect;Password=hireconnect_secret;",
    "Redis": "redis:6379,password=hireconnect_redis_pass,abortConnect=false"
  },
  "RabbitMq": {
    "Enabled": true,
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "hireconnect",
    "Password": "hireconnect_rabbit_pass",
    "VirtualHost": "hireconnect",
    "ExchangeName": "hireconnect.events",
    "QueueName": "analytics_service_queue"
  },
  "JwtSettings": {
    "SecretKey": "HireConnect_SuperSecretKey_Must_Be_At_Least_32_Chars!",
    "Issuer": "hireconnect-auth-service",
    "Audience": "hireconnect-clients",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "AllowedOrigins": ["http://localhost:3000", "http://gateway:5000"],
  "AllowedHosts": "*",
  "Urls": "http://+:8080"
}
