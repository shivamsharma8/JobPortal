{
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "System": "Warning" } }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/auth/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/v1/auth/{**catch-all}" }]
      },
      "profile-route": {
        "ClusterId": "profile-cluster",
        "Match": { "Path": "/profile/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/v1/profile/{**catch-all}" }]
      },
      "jobs-route": {
        "ClusterId": "job-cluster",
        "Match": { "Path": "/jobs/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/v1/jobs/{**catch-all}" }]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": { "Address": "http://auth-service:8080/" }
        },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" }
        }
      },
      "profile-cluster": {
        "Destinations": {
          "profile-service": { "Address": "http://profile-service:8080/" }
        },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" }
        }
      },
      "job-cluster": {
        "Destinations": {
          "job-service": { "Address": "http://job-service:8080/" }
        },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Policy": "ConsecutiveFailures", "Path": "/health" }
        }
      }
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://+:5000"
}
